<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Twist</title>
    <style>@import url('https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&family=Source+Code+Pro:ital,wght@0,200..900;1,200..900&display=swap');
</style>

    <%= favicon_tag %>
    <%= stylesheet_tag "app" %>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <%= link_to routes.path(:root), class: "site-wordmark" do %>
          Twist
        <% end %>

        <nav class="site-nav">
          <% if user_signed_in? %>
            <%= link_to "Books", routes.path(:books), class: nav_link_class(routes.path(:books), routes.path(:root)) %>
            <%= link_to "Invite someone", routes.path(:new_invite), class: nav_link_class(routes.path(:new_invite)) %>
          <% end %>
        </nav>

        <div class="site-user">
          <% if user_signed_in? %>
            <span class="site-user-name"><%= current_user.name %></span>
            <%= form_for :session, routes.path(:logout), class: "inline-block" do |f| %>
              <%= f.submit "Sign out", class: "btn btn-quiet btn-sm" %>
            <% end %>
          <% else %>
            <%= link_to "Log in", routes.path(:login), class: "btn btn-blue btn-sm" %>
          <% end %>
        </div>
      </div>
    </header>

    <div class="site-main">
      <%# Turbo throws everything outside the target frame away, so views that
          answer a frame request render this inside the frame instead. %>
      <%= render "shared/flash" unless turbo_frame_request? %>

      <%= yield %>
    </div>

    <%= javascript_tag "app" %>
  </body>
</html>
