<div class="reading-layout">
  <aside id="sidebar" class="chapter-toc" aria-label="Chapters">
    <p class="chapter-toc-heading">Chapters</p>
    <ol>
      <% toc_chapters.each do |toc_chapter| %>
        <li>
          <a
            class="chapter-toc-link <%= "chapter-toc-link-active" if toc_chapter.id == chapter.id %>"
            href="<%= chapter_path(book, toc_chapter) %>"
          >
            <span class="chapter-toc-number"><%= chapter_number(toc_chapter) %></span>
            <span><%= toc_chapter.title %></span>
          </a>
        </li>
      <% end %>
    </ol>
  </aside>

  <div class="reading-column chapter">
    <header class="mb-4">
      <h1>
        <%= link_to book_path(book) do %>
          <%= book.title %>
        <% end %>
      </h1>

      <%= render "books/commit_info", branch: commit.branch, commit: commit %>
    </header>

    <%= render "chapters/chapter_links", book: book, previous_chapter: previous_chapter, next_chapter: next_chapter  %>
    <h2>
      <%= chapter.header %>
    </h2>
    <div class="elements">
      <% elements.each do |element| %>
        <%= render "elements/element", book: book, chapter: chapter, element: element, notes_frame: true %>
      <% end %>
    </div>

    <% if footnotes.any? %>
      <div>
        <h3>Footnotes</h3>
        <% footnotes.each do |footnote| %>
          <div><%= raw footnote.content %></div>
        <% end %>
      </div>
    <% end %>
    <%= render "chapters/chapter_links", book: book, previous_chapter: previous_chapter, next_chapter: next_chapter  %>
  </div>
</div>
