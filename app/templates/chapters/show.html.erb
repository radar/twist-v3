<div class="flex flex-wrap lg:flex-no-wrap mx-16 md:mx-0">
  <div class="w-1/12"></div>
  <div class="w-full lg:w-3/4 flex-grow mr-4 chapter">
    <header class="mb-4">
      <h1>
        <%= link_to book_path(book) do %>
          <%= book.title %>
        <% end %>
      </h1>

      <%= render "books/commit_info", branch: commit.branch, commit: commit %>
    </header>
    <%= render "chapters/chapter_links", book: book, previous_chapter: previous_chapter, next_chapter: next_chapter  %>
    <h2 class="mt-3"><%= chapter.position %>. <%= chapter.title %></h2>
    <% elements.each do |element| %>
      <%= render "elements/element", element: element %>
    <% end %>
    {elements &&
      elements.map((element) => (
        <Element
          {...element}
          bookPermalink={bookPermalink}
          key={element.id}
        />
      ))}

    {renderFootnotes()}
    {renderChapterLinks()}
  </div>
</div>
