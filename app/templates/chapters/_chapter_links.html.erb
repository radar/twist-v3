<nav class="chapter-nav">
  <% if previous_chapter %>
    <div class="chapter-nav-prev">
      <span class="chapter-nav-label">&laquo; Previous</span>
      <%= link_to chapter_path(book, previous_chapter) do %>
        <%= previous_chapter.link %>
      <% end %>
    </div>
  <% end %>

  <% if next_chapter %>
    <div class="chapter-nav-next">
      <span class="chapter-nav-label">Next &raquo;</span>
      <%= link_to chapter_path(book, next_chapter) do %>
        <%= next_chapter.link %>
      <% end %>
    </div>
  <% end %>
</nav>
