<div class="note comment" data-test-class="comment">
  <div class="note-avatar">
    <%= gravatar_for user.email, size: 32 %>
  </div>

  <div class="note-main">
    <div class="note-header">
      <div class="note-byline">
        <span class="note-author"><%= user.name %></span>
        &middot;
        <time datetime="<%= comment.created_at.utc.iso8601 %>" title="<%= comment.created_at.utc.strftime("%e %B %Y, %H:%M UTC") %>">
          <%= time_ago_in_words comment.created_at, highest_measure_only: true %> ago
        </time>
      </div>
    </div>

    <div class="note-body">
      <div class="markdown-body">
        <%= render_markdown comment.text %>
      </div>
    </div>
  </div>
</div>
