<div class="max-w-md mx-auto mt-10 p-6 rounded-lg">
  <%= form_for :session, routes.path(:login_post) do |f| %>
    <h1 class="text-2xl font-bold mb-4">Login to Twist</h1>
    <div class="space-y-4">
      <div>
        <%= f.label :email, class: "block font-medium mb-2" %>
        <%= f.email_field :email, class: "w-full border border-gray-300 p-2 mb-2", autocomplete: "email" %>
      </div>
      <div>
        <%= f.label :password, class: "block font-medium mb-2" %>
        <%= f.password_field :password, class: "w-full border border-gray-300 p-2 mb-2", autocomplete: "current-password" %>
      </div>
    </div>
    <div>
      <%= f.submit "Log in", class: "btn btn-blue" %>
    </div>
  <% end %>
</div>
