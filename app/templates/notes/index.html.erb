<div class="reading-column-wide chapter">
  <header class="mb-4">
    <h1>
      <%= link_to book_path(book) do %>
        <%= book.title %>
      <% end %>
    </h1>

    <%= render "books/commit_info", branch: book.default_branch, commit: commit %>
  </header>

  <h2><%= status == "closed" ? "Closed notes" : "Open notes" %></h2>

  <nav class="notes-tabs">
    <%= link_to book_notes_path(book), class: "notes-tab #{"notes-tab-active" if status != "closed"}" do %>
      Open
      <span class="notes-tab-count"><%= open_count %></span>
    <% end %>
    <%= link_to book_notes_path(book, status: "closed"), class: "notes-tab #{"notes-tab-active" if status == "closed"}" do %>
      Closed
      <span class="notes-tab-count"><%= closed_count %></span>
    <% end %>
  </nav>

  <% if notes.any? %>
    <% notes.each do |note| %>
      <% element = note.element %>
      <% chapter = element.chapter %>
      <div class="open-note">
        <div class="open-note-chapter">
          <%= link_to element_path(book: book, chapter: chapter, id: element.id) do %>
            <%= chapter.title %>
          <% end %>
        </div>

        <div class="open-note-element">
          <%= render "elements/content", element: element %>
        </div>

        <div class="open-note-body">
          <%= render "notes/note",
            note: note,
            book: book,
            book_permalink: book.permalink,
            chapter_permalink: chapter.permalink,
            element_id: element.id
          %>
        </div>
      </div>
    <% end %>
  <% else %>
    <em class="notes-empty">
      <%= status == "closed" ? "No notes have been closed on this book yet." : "No open notes for this book." %>
    </em>
  <% end %>
</div>
