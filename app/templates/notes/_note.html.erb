<%#
  return_to keeps the note's forms on the page they were submitted from. Without
  it every one of them lands on the element's own page, which is right from a
  chapter but throws the reader off the book's notes list.
%>
<% return_path = defined?(return_to) ? return_to : nil %>
<div class="note">
  <div class="note-avatar">
    <%= gravatar_for note.user.email %>
  </div>

  <div class="note-main">
    <div class="note-header">
      <div class="note-byline">
        <span class="note-author"><%= note.user.name %></span>
        left note #<%= note.number %>
        &middot;
        <time datetime="<%= note.created_at.utc.iso8601 %>" title="<%= note.created_at.utc.strftime("%e %B %Y, %H:%M UTC") %>">
          <%= distance_of_time_in_words Time.now, note.created_at.utc, highest_measure_only: true %> ago
        </time>
      </div>

      <div class="note-actions">
        <% if can_edit_note?(book: book, note: note) %>
          <%# The edit page has no notes frame, so break out of one if we're in it %>
          <%= link_to "Edit", edit_note_path(note), data: { turbo_frame: "_top" } %>
        <% end %>
        <% if author_of?(book) %>
          <% if note.open? %>
            <%= form_for :note, close_note_path(note), method: :patch, class: "inline-block" do |f| %>
              <% if return_path %>
                <input type="hidden" name="return_to" value="<%= return_path %>" />
              <% end %>
              <%= f.submit "Close", class: "note-action-button" %>
            <% end %>
          <% else %>
            <%= form_for :note, open_note_path(note), method: :patch, class: "inline-block" do |f| %>
              <% if return_path %>
                <input type="hidden" name="return_to" value="<%= return_path %>" />
              <% end %>
              <%= f.submit "Re-open", class: "note-action-button" %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="note-body">
      <div class="markdown-body">
        <%= note.text_markdown %>
      </div>
    </div>

    <% if note.comments.any? %>
      <div class="note-comments">
        <% note.comments.each do |comment| %>
          <%= render "comments/comment", comment: comment, user: comment.user %>
        <% end %>
      </div>
    <% end %>

    <% if can_comment_on_note?(book: book) %>
      <%# Stays inside the notes frame, like the note form does, so replying from
          a chapter drops the comment in underneath the paragraph instead of
          navigating off to the element's own page and losing the reader's place. %>
      <%= form_for :comment, create_note_comment_path(note),
            class: "note-comment-form" do |f| %>
        <% if return_path %>
          <input type="hidden" name="return_to" value="<%= return_path %>" />
        <% end %>
        <div>
          <%# A page can carry many of these forms, so the ids are per note. %>
          <%= f.label for: "comment-text-#{note.id}" do %>
            Reply to this note (Markdown enabled)
          <% end %>
          <%= f.text_area :text, class: "form-textarea", id: "comment-text-#{note.id}" %>
        </div>

        <input
          type="submit"
          class="btn btn-blue btn-sm"
          value="Add Comment"
        />
      <% end %>
    <% end %>
  </div>
</div>
