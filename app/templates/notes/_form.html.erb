<% form_args = defined?(note) ? { values: { note: note }, method: :patch } : { method: :post } %>

<%= form_for :note, path, **form_args do |f| %>
  <div>
    <%= f.label :text do %>
      Leave a note (Markdown enabled)
    <% end %>
    <%= f.text_area :text, class: "form-textarea" %>
  </div>

  <input
    type="submit"
    class="btn btn-blue mb-2 mr-4"
    value="Submit Note"
  />
<% end %>
