<div class="reading-column chapter">
  <header class="mb-4">
    <h1>
      <%= link_to book_path(book) do %>
        <%= book.title %>
      <% end %>
    </h1>

    <%= render "books/commit_info", branch: commit.branch, commit: commit %>
  </header>
  <%= render "elements/element", book: book, chapter: chapter, element: element %>

  <h3>
    <%= element.pretty_note_count %>
  </h3>

  <%= render "notes/form", note: note, path: update_note_path(note) %>
</div>
