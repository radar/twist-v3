

<div class="reading-column chapter">
  <header class="mb-4">
    <h1>
      <%= link_to book_path(book) do %>
        <%= book.title %>
      <% end %>
    </h1>

    <%= render "books/commit_info", branch: commit.branch, commit: commit %>
  </header>
  <%= render "elements/element", book: book, chapter: chapter, element: element %>

  <turbo-frame id="element_notes_<%= element.id %>" class="element-notes">
    <h3>
      <%= element.pretty_note_count %>
    </h3>

    <%= render "notes/form", path: create_note_path(element_id: element.id) %>

    <div class="space-y-4">
      <% notes.each do |note| %>
        <%= render "notes/note",
          note: note,
          book: book,
          book_permalink: book.permalink,
          chapter_permalink: chapter.permalink,
          element_id: element.id
        %>
      <% end %>
    </div>
  </turbo-frame>
</div>
