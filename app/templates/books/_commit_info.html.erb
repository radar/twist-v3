<div class="commit-info">
  <span class="commit-info-ref"><%= branch.name %>@<%= commit.sha.slice(0, 8) %></span>
  <time datetime="<%= commit.created_at.utc.iso8601 %>" title="<%= commit.created_at.utc.strftime("%e %B %Y, %H:%M UTC") %>">
    <%= time_ago_in_words(commit.created_at, only: :days) %> ago
  </time>
</div>
