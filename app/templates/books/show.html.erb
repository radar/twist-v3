<div class="mt-3">
  <h1><%= book.title %></h1>
  <%= render "books/commit_info", branch: book.default_branch, commit: book.default_branch.latest_commit %>
  <ol class='list-decimal list-inside'>
    <% chapters.each do |chapter| %>
      <li>
        <%= link_to chapter_path(book, chapter) do %>
          <%= chapter.title %>
        <% end %>
      </li>
    <% end %>
  </ol>

</div>
